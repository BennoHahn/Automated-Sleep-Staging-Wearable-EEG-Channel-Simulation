# Virtual environments (recreated automatically by Step 0 via requirements.txt)
.venv/
venv/
env/

# Secret NSRR API token files (never upload tokens to GitHub)
.nsrr_token
.env

# Python cache & temporary directories
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
.mplconfig/

# Archived initial 10-subject test run (kept locally on disk, excluded from pipeline & GitHub)
archive_10subj_initial_test/

# Raw EDF/XML recordings & preprocessed NPZ waveforms (too large for GitHub; stored locally on training PC)
# Note: data/splits/ IS tracked so cohort manifests & 10-fold CV splits stay synced across PCs
data/raw/
data/processed/

# Temporary dry-run test output (all real training results in results/ ARE tracked & uploaded to GitHub)
results/dry_run/

# OS metadata
.DS_Store
Thumbs.db
